#!/bin/sh
# SPDX-License-Identifier: GPL-2.0
# Phase 1 PID 1. This file is packaged into the guest, never run on the host.

PATH=/bin:/sbin:/usr/bin:/usr/sbin
export PATH
umask 022

# A mistaken host invocation must not mount filesystems or power off the host.
if [ "$$" -ne 1 ]; then
    printf 'P1:FAIL:AC-05:not-pid1\n' >&2
    exit 1
fi

set -eu
active_ac=AC-05
data_mounted=0

fail()
{
    # Do not let a secondary error or EOF make PID 1 return to the kernel.
    trap - 0 HUP INT TERM
    set +e
    printf 'P1:FAIL:%s:%s\n' "$1" "$2"
    sync
    if [ "$data_mounted" = 1 ]; then
        umount /mnt/data
    fi
    poweroff -f
    while :; do sleep 1; done
}

trap 'fail "$active_ac" "unexpected-exit-$?"' 0
trap 'fail "$active_ac" signal-hup' HUP
trap 'fail "$active_ac" signal-int' INT
trap 'fail "$active_ac" signal-term' TERM

mount_is()
{
    # Use /proc/mounts, not a successful mount command alone, as evidence.
    mount_wanted_path=$1
    mount_wanted_type=$2
    while read -r _mount_source mount_path mount_type _mount_options _mount_rest; do
        if [ "$mount_path" = "$mount_wanted_path" ] &&
           [ "$mount_type" = "$mount_wanted_type" ]; then
            return 0
        fi
    done < /proc/mounts
    return 1
}

active_ac=AC-07
mkdir -p /proc /sys /dev /tmp /mnt/data /var/run
mount -t proc proc /proc || fail AC-07 mount-proc
mount -t sysfs sysfs /sys || fail AC-07 mount-sysfs
# DEVTMPFS_MOUNT does not automatically mount /dev inside an initramfs.
mount -t devtmpfs devtmpfs /dev || fail AC-07 mount-devtmpfs
mount -t tmpfs -o mode=1777,nosuid,nodev tmpfs /tmp || fail AC-07 mount-tmpfs
[ -c /dev/console ] || mknod -m 600 /dev/console c 5 1
[ -c /dev/null ] || mknod -m 666 /dev/null c 1 3
[ -c /dev/ttyS0 ] || fail AC-06 missing-serial-console
exec </dev/console >/dev/console 2>&1

mount_is /proc proc || fail AC-07 wrong-proc-filesystem
mount_is /sys sysfs || fail AC-07 wrong-sys-filesystem
mount_is /dev devtmpfs || fail AC-07 wrong-dev-filesystem
mount_is /tmp tmpfs || fail AC-07 wrong-tmp-filesystem

test_mode=0
test_round=
test_nonce=
# Do not evaluate the command line as shell code, or expand any globs in it.
set -f
# Kernel command-line tokens are intentionally split on whitespace, not lines.
# shellcheck disable=SC2013
for boot_argument in $(cat /proc/cmdline); do
    case "$boot_argument" in
        phase1.test=*) test_mode=${boot_argument#phase1.test=} ;;
        phase1.round=*) test_round=${boot_argument#phase1.round=} ;;
        phase1.nonce=*) test_nonce=${boot_argument#phase1.nonce=} ;;
    esac
done
set +f
case "$test_mode" in
    0|1) ;;
    *) fail AC-05 invalid-test-mode ;;
esac

active_ac=AC-02
[ -s /etc/phase1-release ] || fail AC-02 missing-expected-kernel-release
[ -s /etc/phase1-source ] || fail AC-01 missing-source-identity
expected_release=$(cat /etc/phase1-release)
actual_release=$(uname -r)
source_identity=$(cat /etc/phase1-source)
printf 'P1:KERNEL:%s\n' "$actual_release"
printf 'P1:SOURCE:%s\n' "$source_identity"
[ "$actual_release" = "$expected_release" ] || fail AC-02 kernel-release-mismatch
[ "$(uname -m)" = x86_64 ] || fail AC-02 wrong-architecture
printf 'P1:INIT_OK\n'

active_ac=AC-07
printf 'phase1-filesystem-probe\n' > /tmp/phase1-probe
[ "$(cat /tmp/phase1-probe)" = phase1-filesystem-probe ] || fail AC-07 tmp-readback
rm /tmp/phase1-probe
[ ! -e /tmp/phase1-probe ] || fail AC-07 tmp-delete
printf 'P1:FS_OK\n'

if [ "$test_mode" = 0 ]; then
    active_ac=AC-06
    PS1='phase1# '
    TERM=vt100
    export PS1 TERM
    printf 'P1:SHELL_READY\n'
    # Keep PID 1 alive if the user exits the shell. Give the shell its own
    # session and controlling tty, so Ctrl-C and job control work correctly.
    while :; do
        setsid cttyhack sh -i </dev/ttyS0 >/dev/ttyS0 2>&1 || :
        printf 'P1:SHELL_RESTART\n'
        sleep 1
    done
fi

active_ac=AC-08
case "$test_round" in
    1|2) ;;
    *) fail AC-08 invalid-test-round ;;
esac
case "$test_nonce" in
    ''|*[!0-9a-f]*) fail AC-08 invalid-test-nonce ;;
esac
[ "${#test_nonce}" -le 128 ] || fail AC-08 overlong-test-nonce

disk_wait=0
while [ ! -b /dev/vda ]; do
    [ "$disk_wait" -lt 10 ] || fail AC-08 missing-virtio-disk
    disk_wait=$((disk_wait + 1))
    sleep 1
done
mount -t ext4 -o rw /dev/vda /mnt/data || fail AC-08 mount-data
data_mounted=1
mount_is /mnt/data ext4 || fail AC-08 wrong-data-filesystem
if [ "$test_round" = 1 ]; then
    [ ! -e /mnt/data/phase1-marker ] || fail AC-08 stale-persistence-marker
    printf '%s\n' "$test_nonce" > /mnt/data/phase1-marker
    sync
    [ "$(cat /mnt/data/phase1-marker)" = "$test_nonce" ] || fail AC-08 disk-write-readback
    printf 'P1:DISK_WRITE_OK\n'
else
    [ -f /mnt/data/phase1-marker ] || fail AC-08 missing-persistence-marker
    [ "$(cat /mnt/data/phase1-marker)" = "$test_nonce" ] || fail AC-08 persistence-mismatch
    printf 'P1:DISK_PERSIST_OK\n'
fi

active_ac=AC-09
network_interface=
for network_device in /sys/class/net/*; do
    [ -e "$network_device/device/driver" ] || continue
    network_driver=$(readlink "$network_device/device/driver")
    case "$network_driver" in
        */virtio_net) network_interface=${network_device##*/}; break ;;
    esac
done
[ -n "$network_interface" ] || fail AC-09 missing-virtio-network
ip link set lo up || fail AC-09 loopback-up
ip link set "$network_interface" up || fail AC-09 network-link-up
rm -f /tmp/phase1-dhcp-lease
udhcpc -f -n -q -t 3 -T 2 -i "$network_interface" -s /etc/udhcpc.script ||
    fail AC-09 dhcp-failed
[ -s /tmp/phase1-dhcp-lease ] || fail AC-09 missing-configured-lease
read -r lease_interface lease_address lease_prefix lease_router < /tmp/phase1-dhcp-lease
[ "$lease_interface" = "$network_interface" ] || fail AC-09 lease-interface-mismatch
ip -4 addr show dev "$network_interface" |
    grep -F "inet $lease_address/$lease_prefix " >/dev/null || fail AC-09 lease-not-applied
ip -4 route show default |
    grep -F "via $lease_router dev $network_interface" >/dev/null || fail AC-09 missing-default-route
printf 'P1:DHCP:interface=%s address=%s/%s router=%s\n' \
    "$network_interface" "$lease_address" "$lease_prefix" "$lease_router"
ip -4 addr show dev "$network_interface"
ip -4 route show
printf 'P1:NET_OK\n'

if [ "$test_round" = 1 ]; then
    printf 'P1:ROUND1_OK\n'
else
    printf 'P1:PASS\n'
fi

active_ac=AC-10
printf 'P1:POWER_OFF\n'
sync
umount /mnt/data || fail AC-10 unmount-data
data_mounted=0
poweroff -f
# Successful poweroff does not return. A failure must never look like success.
fail AC-10 poweroff-returned
